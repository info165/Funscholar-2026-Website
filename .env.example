# These are read by the Cloudflare Pages Function in functions/api/contact.ts,
# NOT by Next.js. Set them in the Cloudflare dashboard under
# Settings → Environment variables. A local .env.local does not reach the
# function — use `npx wrangler pages dev out` to run it locally.

# Secret. From resend.com/api-keys. Mark it "Encrypt" in Cloudflare.
RESEND_API_KEY=

# Inbox that should receive contact form enquiries.
CONTACT_TO_EMAIL=

# Optional. Must be on a domain verified with Resend. Left unset, it falls back
# to Resend's test sender, which can only deliver to your own account address.
# CONTACT_FROM_EMAIL=Funscholar Website <info@funscholar.com>
