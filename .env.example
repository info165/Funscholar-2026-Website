# Copy to .env.local and point at your own MySQL instance.
# The app throws on startup if DATABASE_URL is missing.

# Local development (XAMPP default)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/funscholar_db

# Production example — TiDB Cloud Serverless. Note port 4000, not 3306.
# DATABASE_URL=mysql://xxxxx.root:password@gateway01.<region>.prod.aws.tidbcloud.com:4000/funscholar_db

# TLS is enabled automatically for any non-local host, so you normally do not
# need this. Set it only to force the behaviour either way.
# DB_SSL=true

# Connections held per instance. Defaults to 3. Raise only if your host allows
# plenty of connections; free tiers cap the whole account fairly low.
# DB_CONNECTION_LIMIT=3
